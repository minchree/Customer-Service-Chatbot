# Copy this file to .env and fill in ONE of the keys below.
# .env is listed in .gitignore so your key is never pushed to GitHub.

# Which API to use: google (Gemini, has a free tier) or openai
LLM_PROVIDER=google

GOOGLE_API_KEY=your_google_ai_studio_key_here
# OPENAI_API_KEY=your_openai_key_here

# Optional: override the default model (gemini-3.5-flash-lite / gpt-4o-mini), e.g. MODEL_NAME=gemini-3.8-flash
# MODEL_NAME=
